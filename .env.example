API_PORT=8000
MODEL_PATH=./models
DATA_PATH=./data
LOG_LEVEL=INFO

# Streaming MQTT (sensor IoT real)
# ================================
# Con docker-compose el broker ya está en la red interna como "mqtt"
# (la API del compose lo usa por defecto).
MQTT_ENABLED=1
MQTT_BROKER=mqtt
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
